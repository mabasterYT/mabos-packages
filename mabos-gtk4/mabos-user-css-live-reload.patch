--- a/gtk/gtksettings.c
+++ b/gtk/gtksettings.c
@@ -1159,6 +1159,94 @@
   return new_cascade;
 }
 
+#ifdef G_OS_UNIX
+/* MabOS: the user's gtk.css is read again when it changes, so open windows follow a theme switch
+ * instead of only newly started apps. The folder is watched rather than the file, so writes that
+ * replace the file (a new file renamed over it) and its removal are seen too; changes coming in a
+ * row are taken together after a short pause. */
+static GtkCssProvider *user_css_provider = NULL;
+static char *user_css_path = NULL;
+static GFileMonitor *user_css_monitor = NULL;
+static guint user_css_reload_id = 0;
+
+static gboolean
+user_css_reload (gpointer data)
+{
+  user_css_reload_id = 0;
+
+  if (g_file_test (user_css_path, G_FILE_TEST_IS_REGULAR))
+    gtk_css_provider_load_from_path (user_css_provider, user_css_path);
+  else
+    gtk_css_provider_load_from_string (user_css_provider, "");
+
+  return G_SOURCE_REMOVE;
+}
+
+static gboolean
+user_css_is (GFile *file)
+{
+  char *name;
+  gboolean match;
+
+  if (file == NULL)
+    return FALSE;
+
+  name = g_file_get_basename (file);
+  match = g_strcmp0 (name, "gtk.css") == 0;
+  g_free (name);
+
+  return match;
+}
+
+static void
+user_css_changed (GFileMonitor      *monitor,
+                  GFile             *file,
+                  GFile             *other_file,
+                  GFileMonitorEvent  event,
+                  gpointer           data)
+{
+  switch (event)
+    {
+    case G_FILE_MONITOR_EVENT_CHANGES_DONE_HINT:
+    case G_FILE_MONITOR_EVENT_CREATED:
+    case G_FILE_MONITOR_EVENT_DELETED:
+    case G_FILE_MONITOR_EVENT_RENAMED:
+    case G_FILE_MONITOR_EVENT_MOVED_IN:
+    case G_FILE_MONITOR_EVENT_MOVED_OUT:
+      break;
+    default:
+      return;
+    }
+
+  if (!user_css_is (file) && !user_css_is (other_file))
+    return;
+
+  if (user_css_reload_id != 0)
+    g_source_remove (user_css_reload_id);
+  user_css_reload_id = g_timeout_add (150, user_css_reload, NULL);
+}
+
+static void
+user_css_watch (GtkCssProvider *provider,
+                char           *path)
+{
+  char *folder;
+  GFile *file;
+
+  user_css_provider = provider;
+  user_css_path = path;
+
+  folder = g_path_get_dirname (path);
+  file = g_file_new_for_path (folder);
+  user_css_monitor = g_file_monitor_directory (file, G_FILE_MONITOR_WATCH_MOVES, NULL, NULL);
+  if (user_css_monitor != NULL)
+    g_signal_connect (user_css_monitor, "changed", G_CALLBACK (user_css_changed), NULL);
+
+  g_object_unref (file);
+  g_free (folder);
+}
+#endif
+
 static void
 settings_init_style (GtkSettings *settings)
 {
@@ -1206,7 +1294,11 @@
                        G_FILE_TEST_IS_REGULAR))
         gtk_css_provider_load_from_path (css_provider, css_path);
 
+#ifdef G_OS_UNIX
+      user_css_watch (css_provider, css_path); /* keeps css_path */
